# Copy to terraform.tfvars (gitignored) and edit.
region      = "us-east-2"
owner       = "evy"
alert_email = "you@example.com"

# Turn these on only for a bounded scan window, then off again.
enable_config      = true
enable_guardduty   = false
enable_securityhub = false

# Organization member accounts: set any of these false if an SCP blocks it.
manage_password_policy             = true
manage_ebs_default_encryption      = true
manage_account_public_access_block = true
enable_access_analyzer             = true
